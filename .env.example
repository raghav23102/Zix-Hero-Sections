# ============================================================
# ZIX HERO SECTIONS — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# ----- SHOPIFY APP CREDENTIALS -----
# Get these from your Shopify Partner Dashboard
SHOPIFY_API_KEY=your_shopify_api_key_here
SHOPIFY_API_SECRET=your_shopify_api_secret_here

# Your Shopify Partner / Distribution Organization ID
SHOPIFY_PARTNER_ID=5157587

# The public URL of your app (use ngrok or Cloudflare Tunnel for local dev)
# Example: https://abc123.ngrok.io
SHOPIFY_APP_URL=https://your-app-url.ngrok.io

# Shopify API scopes
SCOPES=write_themes,read_themes,read_products,write_products,read_script_tags,write_script_tags

# ----- DATABASE -----
# PostgreSQL connection string
# Example: postgresql://username:password@localhost:5432/zix_hero_sections
DATABASE_URL=postgresql://postgres:password@localhost:5432/zix_hero_sections

# ----- APPLICATION -----
NODE_ENV=development
PORT=3000

# ----- BILLING PRICES (configurable, in USD) -----
PRICE_BASIC=9.99
PRICE_PRO=19.99
PRICE_ULTIMATE=39.99

# ----- SESSION -----
# Randomly generated secret for session signing (min 32 chars)
SESSION_SECRET=your_random_session_secret_minimum_32_characters_long

# ----- OPTIONAL: LOCAL DEV -----
# Set to true to bypass Shopify auth in local development
# NEVER set to true in production
DEV_BYPASS_AUTH=false
