{
  "version": 2,
  "outputDirectory": "build/client",
  "functions": {
    "api/index.ts": {
      "includeFiles": "build/**",
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.ts"
    },
    {
      "src": "/",
      "has": [{ "type": "query", "key": "shop" }],
      "dest": "/index.html"
    },
    {
      "src": "/",
      "has": [{ "type": "query", "key": "host" }],
      "dest": "/index.html"
    },
    {
      "src": "/",
      "dest": "/landing.html"
    },
    {
      "src": "/privacy",
      "dest": "/privacy.html"
    },
    {
      "src": "/privacy-policy",
      "dest": "/privacy.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
