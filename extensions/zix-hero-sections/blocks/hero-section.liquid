{% comment %}
  Zix Hero Sections — Theme App Extension Block

  ■ SECTION ID LINKING
  If block.settings.section_id is set, the block reads a Shopify shop
  metafield written by the Zix Hero Sections app (namespace: zix_hero,
  key: section_{id}) and uses those values instead of block settings.
  Block settings always act as the fallback.

  ■ TEMPLATE IDS
  modern-split | fullscreen-image | video-background | product-showcase
  fashion | minimal | gradient | image-cta | collection | sale
  countdown | before-after | animated | editorial
{% endcomment %}

{%- comment -%}
  ── VARIABLE RESOLUTION ────────────────────────────────────────────
  Priority: metafield (written by app) → block settings (theme editor)
{%- endcomment -%}
{%- assign _meta = nil -%}
{%- if block.settings.section_id != blank -%}
  {%- assign _meta_key = 'section_' | append: block.settings.section_id -%}
  {%- assign _meta = shop.metafields.zix_hero[_meta_key].value -%}
{%- endif -%}

{%- if _meta -%}
  {%- assign _tid           = _meta.templateId              | default: block.settings.template_id -%}
  {%- assign _heading       = _meta.heading                 | default: block.settings.heading -%}
  {%- assign _subheading    = _meta.subheading              | default: block.settings.subheading -%}
  {%- assign _description   = _meta.description             | default: block.settings.description -%}
  {%- assign _badge         = _meta.badgeText               | default: block.settings.badge_text -%}
  {%- assign _pri_txt       = _meta.primaryButtonText       | default: block.settings.primary_button_text -%}
  {%- assign _pri_url       = _meta.primaryButtonUrl        | default: block.settings.primary_button_url -%}
  {%- assign _sec_txt       = _meta.secondaryButtonText     | default: block.settings.secondary_button_text -%}
  {%- assign _sec_url       = _meta.secondaryButtonUrl      | default: block.settings.secondary_button_url -%}
  {%- assign _bg            = _meta.backgroundColor        | default: block.settings.background_color -%}
  {%- assign _ov_color      = _meta.overlayColor            | default: block.settings.overlay_color -%}
  {%- assign _h_color       = _meta.headingColor            | default: block.settings.heading_color -%}
  {%- assign _t_color       = _meta.textColor               | default: block.settings.text_color -%}
  {%- assign _btn_color     = _meta.primaryButtonColor      | default: block.settings.button_color -%}
  {%- assign _btn_txt       = _meta.primaryButtonTextColor  | default: block.settings.button_text_color -%}
  {%- assign _btn_r         = _meta.primaryButtonBorderRadius | default: block.settings.button_border_radius -%}
  {%- assign _height        = _meta.sectionHeight           | default: block.settings.section_height -%}
  {%- assign _width         = _meta.contentWidth            | default: block.settings.content_width -%}
  {%- assign _pt            = _meta.desktopPaddingTop       | default: block.settings.desktop_padding_top -%}
  {%- assign _pb            = _meta.desktopPaddingBottom    | default: block.settings.desktop_padding_bottom -%}
  {%- assign _align         = _meta.textAlignment           | default: block.settings.text_alignment -%}
  {%- assign _g_start       = _meta.backgroundGradientStart | default: block.settings.gradient_start -%}
  {%- assign _g_end         = _meta.backgroundGradientEnd   | default: block.settings.gradient_end -%}
  {%- assign _anim          = _meta.animationType           | default: block.settings.animation_type -%}
  {%- assign _discount      = _meta.discountText            | default: block.settings.discount_text -%}
  {%- assign _cd_date       = _meta.countdownEndDate        | default: block.settings.countdown_end_date -%}
  {%- assign _cd_msg        = _meta.countdownCompletionMessage | default: block.settings.countdown_completion_message -%}
  {%- assign _img_pos       = _meta.imagePosition           | default: block.settings.image_position -%}
  {%- comment -%} overlayOpacity: app stores 0–1, block uses 0–100 {%- endcomment -%}
  {%- if _meta.overlayOpacity -%}
    {%- assign _ov_opacity  = _meta.overlayOpacity | times: 100 | round -%}
  {%- else -%}
    {%- assign _ov_opacity  = block.settings.overlay_opacity -%}
  {%- endif -%}
  {%- comment -%} headingSize: app uses sm/md/lg/xl/2xl/3xl → rem values {%- endcomment -%}
  {%- case _meta.headingSize -%}
    {%- when 'sm'  -%}{%- assign _h_size = '1.5rem'   -%}
    {%- when 'md'  -%}{%- assign _h_size = '2rem'     -%}
    {%- when 'lg'  -%}{%- assign _h_size = '2.625rem' -%}
    {%- when 'xl'  -%}{%- assign _h_size = '3.25rem'  -%}
    {%- when '2xl' -%}{%- assign _h_size = '4rem'     -%}
    {%- when '3xl' -%}{%- assign _h_size = '5rem'     -%}
    {%- else       -%}{%- assign _h_size = block.settings.heading_size -%}
  {%- endcase -%}
{%- else -%}
  {%- assign _tid       = block.settings.template_id -%}
  {%- assign _heading   = block.settings.heading -%}
  {%- assign _subheading = block.settings.subheading -%}
  {%- assign _description = block.settings.description -%}
  {%- assign _badge     = block.settings.badge_text -%}
  {%- assign _pri_txt   = block.settings.primary_button_text -%}
  {%- assign _pri_url   = block.settings.primary_button_url -%}
  {%- assign _sec_txt   = block.settings.secondary_button_text -%}
  {%- assign _sec_url   = block.settings.secondary_button_url -%}
  {%- assign _bg        = block.settings.background_color -%}
  {%- assign _ov_color  = block.settings.overlay_color -%}
  {%- assign _ov_opacity = block.settings.overlay_opacity -%}
  {%- assign _h_color   = block.settings.heading_color -%}
  {%- assign _t_color   = block.settings.text_color -%}
  {%- assign _btn_color = block.settings.button_color -%}
  {%- assign _btn_txt   = block.settings.button_text_color -%}
  {%- assign _btn_r     = block.settings.button_border_radius -%}
  {%- assign _height    = block.settings.section_height -%}
  {%- assign _width     = block.settings.content_width -%}
  {%- assign _pt        = block.settings.desktop_padding_top -%}
  {%- assign _pb        = block.settings.desktop_padding_bottom -%}
  {%- assign _h_size    = block.settings.heading_size -%}
  {%- assign _align     = block.settings.text_alignment -%}
  {%- assign _g_start   = block.settings.gradient_start -%}
  {%- assign _g_end     = block.settings.gradient_end -%}
  {%- assign _anim      = block.settings.animation_type -%}
  {%- assign _discount  = block.settings.discount_text -%}
  {%- assign _cd_date   = block.settings.countdown_end_date -%}
  {%- assign _cd_msg    = block.settings.countdown_completion_message -%}
  {%- assign _img_pos   = block.settings.image_position -%}
{%- endif -%}

<div
  class="zix-hero zix-hero--{{ _tid }}"
  id="zix-hero-{{ block.id }}"
  style="
    --zix-bg: {{ _bg }};
    --zix-overlay-color: {{ _ov_color }};
    --zix-overlay-opacity: {{ _ov_opacity | divided_by: 100.0 }};
    --zix-heading-color: {{ _h_color }};
    --zix-text-color: {{ _t_color }};
    --zix-btn-color: {{ _btn_color }};
    --zix-btn-text: {{ _btn_txt }};
    --zix-btn-radius: {{ _btn_r }}px;
    --zix-height: {{ _height }};
    --zix-pt: {{ _pt }}px;
    --zix-pb: {{ _pb }}px;
    --zix-heading-size: {{ _h_size }};
    --zix-text-align: {{ _align }};
    --zix-gradient-start: {{ _g_start }};
    --zix-gradient-end: {{ _g_end }};
  "
  {{ block.shopify_attributes }}
>

  {%- comment -%} ── BACKGROUND ──────────────────────────────────────── {%- endcomment -%}
  {%- if _tid == 'video-background' and block.settings.video_url != blank -%}
    <div class="zix-hero__video-wrap">
      <video class="zix-hero__video" autoplay muted loop playsinline aria-hidden="true">
        <source src="{{ block.settings.video_url }}" type="video/mp4">
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 1920 | image_tag: class: 'zix-hero__video-fallback', loading: 'lazy', alt: block.settings.image.alt }}
        {%- endif -%}
      </video>
    </div>
  {%- elsif block.settings.image != blank
      and _tid != 'modern-split'
      and _tid != 'product-showcase'
      and _tid != 'image-cta'
      and _tid != 'minimal'
      and _tid != 'gradient' -%}
    <div
      class="zix-hero__bg-image"
      style="background-image: url('{{ block.settings.image | image_url: width: 1920 }}');"
      role="img"
      aria-label="{{ block.settings.image.alt | escape }}"
    ></div>
  {%- endif -%}

  {%- comment -%} ── OVERLAY ─────────────────────────────────────────── {%- endcomment -%}
  {%- if _ov_opacity > 0 -%}
    <div class="zix-hero__overlay" aria-hidden="true"></div>
  {%- endif -%}

  {%- comment -%} ── MAIN CONTENT ────────────────────────────────────── {%- endcomment -%}
  <div class="zix-hero__inner zix-hero__inner--{{ _width }}">

    {%- comment -%} SPLIT LAYOUTS: modern-split, product-showcase, image-cta, editorial {%- endcomment -%}
    {%- if _tid == 'modern-split' or _tid == 'product-showcase' or _tid == 'image-cta' or _tid == 'editorial' -%}
      <div class="zix-hero__split {% if _img_pos == 'left' %}zix-hero__split--reverse{% endif %}">
        <div class="zix-hero__split-content zix-animate {{ _anim }}" data-zix-animate>
          {%- render 'zix-hero-content',
            badge_text: _badge,
            subheading: _subheading,
            heading: _heading,
            description: _description,
            primary_button_text: _pri_txt,
            primary_button_url: _pri_url,
            secondary_button_text: _sec_txt,
            secondary_button_url: _sec_url
          -%}
          {%- if _tid == 'product-showcase' and block.settings.product_price != blank -%}
            <p class="zix-hero__product-price">{{ block.settings.product_price }}</p>
          {%- endif -%}
        </div>
        {%- if block.settings.image != blank -%}
          <div class="zix-hero__split-image">
            {{ block.settings.image | image_url: width: 900 | image_tag:
              loading: 'lazy',
              class: 'zix-hero__img',
              alt: block.settings.image.alt,
              widths: '400, 600, 800, 900',
              sizes: '(min-width: 768px) 50vw, 100vw'
            }}
          </div>
        {%- endif -%}
      </div>

    {%- comment -%} BEFORE/AFTER {%- endcomment -%}
    {%- elsif _tid == 'before-after' -%}
      <div class="zix-hero__center zix-animate {{ _anim }}" data-zix-animate>
        {%- render 'zix-hero-content',
          badge_text: _badge,
          subheading: _subheading,
          heading: _heading,
          description: _description,
          primary_button_text: _pri_txt,
          primary_button_url: _pri_url,
          secondary_button_text: _sec_txt,
          secondary_button_url: _sec_url
        -%}
      </div>
      <div class="zix-before-after" id="zix-ba-{{ block.id }}" aria-label="Before and after comparison">
        {%- if block.settings.after_image != blank -%}
          {{ block.settings.after_image | image_url: width: 900 | image_tag: class: 'zix-ba__after', loading: 'lazy', alt: block.settings.after_image.alt | default: 'After' }}
        {%- else -%}
          <div class="zix-ba__after zix-ba__placeholder">After</div>
        {%- endif -%}
        <div class="zix-ba__before-wrap" style="width: 50%;">
          {%- if block.settings.before_image != blank -%}
            {{ block.settings.before_image | image_url: width: 900 | image_tag: class: 'zix-ba__before', loading: 'lazy', alt: block.settings.before_image.alt | default: 'Before' }}
          {%- else -%}
            <div class="zix-ba__before zix-ba__placeholder">Before</div>
          {%- endif -%}
        </div>
        <button class="zix-ba__handle" aria-label="{{ 'sections.zix.before_after_drag' | t: default: 'Drag to compare before and after' }}">
          <span class="zix-ba__handle-icon" aria-hidden="true">↔</span>
        </button>
      </div>

    {%- comment -%} COUNTDOWN {%- endcomment -%}
    {%- elsif _tid == 'countdown' -%}
      <div class="zix-hero__center zix-animate {{ _anim }}" data-zix-animate>
        {%- render 'zix-hero-content',
          badge_text: _badge,
          subheading: _subheading,
          heading: _heading,
          description: _description,
          primary_button_text: _pri_txt,
          primary_button_url: _pri_url,
          secondary_button_text: _sec_txt,
          secondary_button_url: _sec_url
        -%}
        {%- if _cd_date != blank -%}
          <div class="zix-countdown" data-zix-countdown="{{ _cd_date }}" data-zix-completion="{{ _cd_msg | escape }}">
            <div class="zix-countdown__unit">
              <span class="zix-countdown__value" data-zix-days>00</span>
              <span class="zix-countdown__label">{{ 'sections.zix.days' | t: default: 'Days' }}</span>
            </div>
            <div class="zix-countdown__sep">:</div>
            <div class="zix-countdown__unit">
              <span class="zix-countdown__value" data-zix-hours>00</span>
              <span class="zix-countdown__label">{{ 'sections.zix.hours' | t: default: 'Hours' }}</span>
            </div>
            <div class="zix-countdown__sep">:</div>
            <div class="zix-countdown__unit">
              <span class="zix-countdown__value" data-zix-minutes>00</span>
              <span class="zix-countdown__label">{{ 'sections.zix.minutes' | t: default: 'Minutes' }}</span>
            </div>
            <div class="zix-countdown__sep">:</div>
            <div class="zix-countdown__unit">
              <span class="zix-countdown__value" data-zix-seconds>00</span>
              <span class="zix-countdown__label">{{ 'sections.zix.seconds' | t: default: 'Seconds' }}</span>
            </div>
          </div>
        {%- endif -%}
      </div>

    {%- comment -%} CENTERED / DEFAULT: fashion, minimal, gradient, collection, sale, animated, fullscreen-image, video-background {%- endcomment -%}
    {%- else -%}
      <div class="
        zix-hero__center
        {%- if _tid == 'fashion' %} zix-hero__center--bottom{%- endif -%}
        {%- if _tid == 'animated' %} zix-hero__center--animated{%- endif -%}
        zix-animate {{ _anim }}
      " data-zix-animate>
        {%- render 'zix-hero-content',
          badge_text: _badge,
          subheading: _subheading,
          heading: _heading,
          description: _description,
          primary_button_text: _pri_txt,
          primary_button_url: _pri_url,
          secondary_button_text: _sec_txt,
          secondary_button_url: _sec_url
        -%}
        {%- if _tid == 'sale' and _discount != blank -%}
          <p class="zix-hero__discount">{{ _discount }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>{%- comment -%} /.zix-hero__inner {%- endcomment -%}
</div>

{% schema %}
{
  "name": "Zix Hero Section",
  "target": "section",
  "stylesheet": "zix-hero.css",
  "javascript": "zix-hero.js",
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "Zix Section ID (optional)",
      "placeholder": "e.g. cmabcd1234efgh",
      "info": "Paste your Zix Section ID to auto-load your design. (Note: Shopify doesn't hide the other settings below, but they will be ignored when an ID is pasted here.)"
    },
    {
      "type": "select",
      "id": "template_id",
      "label": "Hero Template",
      "default": "modern-split",
      "options": [
        { "value": "modern-split",      "label": "Modern Split" },
        { "value": "fullscreen-image",  "label": "Full Screen Image" },
        { "value": "video-background",  "label": "Video Background" },
        { "value": "product-showcase",  "label": "Product Showcase" },
        { "value": "fashion",           "label": "Fashion" },
        { "value": "minimal",           "label": "Minimal" },
        { "value": "gradient",          "label": "Gradient Modern" },
        { "value": "image-cta",         "label": "Image + CTA" },
        { "value": "collection",        "label": "Collection" },
        { "value": "sale",              "label": "Sale Promotion" },
        { "value": "countdown",         "label": "Countdown" },
        { "value": "before-after",      "label": "Before & After" },
        { "value": "animated",          "label": "Animated" },
        { "value": "editorial",         "label": "Premium Editorial" }
      ]
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "placeholder": "SALE, NEW, etc."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Beautiful Hero Section"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Add a professional hero section to your store without any coding."
    },
    {
      "type": "text",
      "id": "primary_button_text",
      "label": "Primary Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "primary_button_url",
      "label": "Primary Button URL"
    },
    {
      "type": "text",
      "id": "secondary_button_text",
      "label": "Secondary Button Text"
    },
    {
      "type": "url",
      "id": "secondary_button_url",
      "label": "Secondary Button URL"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "default": "right",
      "options": [
        { "value": "left",  "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "Video URL (MP4)"
    },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Before Image (Before/After template)"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "After Image (Before/After template)"
    },
    {
      "type": "text",
      "id": "product_price",
      "label": "Product Price (Product Showcase template)",
      "placeholder": "$49.99"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#1a1a2e"
    },
    {
      "type": "checkbox",
      "id": "use_gradient",
      "label": "Use gradient background",
      "default": false
    },
    {
      "type": "color",
      "id": "gradient_start",
      "label": "Gradient Start Color",
      "default": "#667eea"
    },
    {
      "type": "color",
      "id": "gradient_end",
      "label": "Gradient End Color",
      "default": "#764ba2"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading Size",
      "default": "3.25rem",
      "options": [
        { "value": "1.5rem",   "label": "Small" },
        { "value": "2rem",     "label": "Medium" },
        { "value": "2.625rem", "label": "Large" },
        { "value": "3.25rem",  "label": "XL" },
        { "value": "4rem",     "label": "2XL" },
        { "value": "5rem",     "label": "3XL" }
      ]
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "default": "center",
      "options": [
        { "value": "left",   "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right",  "label": "Right" }
      ]
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "Section Height",
      "default": "600px",
      "options": [
        { "value": "400px", "label": "400px" },
        { "value": "500px", "label": "500px" },
        { "value": "600px", "label": "600px" },
        { "value": "700px", "label": "700px" },
        { "value": "800px", "label": "800px" },
        { "value": "100vh", "label": "Full Screen" }
      ]
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content Width",
      "default": "wide",
      "options": [
        { "value": "narrow", "label": "Narrow" },
        { "value": "medium", "label": "Medium" },
        { "value": "wide",   "label": "Wide" },
        { "value": "full",   "label": "Full" }
      ]
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Button Border Radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "enable_animation",
      "label": "Enable animation",
      "default": true
    },
    {
      "type": "select",
      "id": "animation_type",
      "label": "Animation Type",
      "default": "fade",
      "options": [
        { "value": "",           "label": "None" },
        { "value": "fade",       "label": "Fade In" },
        { "value": "slide-up",   "label": "Slide Up" },
        { "value": "slide-left", "label": "Slide Left" }
      ]
    },
    {
      "type": "text",
      "id": "discount_text",
      "label": "Discount Text (Sale template)",
      "placeholder": "Use code: SAVE20"
    },
    {
      "type": "text",
      "id": "countdown_end_date",
      "label": "Countdown End Date",
      "placeholder": "2025-12-31T23:59:59"
    },
    {
      "type": "text",
      "id": "countdown_completion_message",
      "label": "Countdown Completion Message",
      "default": "The offer has ended. Check back soon!"
    }
  ]
}
{% endschema %}
