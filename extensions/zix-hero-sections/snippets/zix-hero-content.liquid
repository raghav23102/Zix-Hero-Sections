{% comment %}
  Snippet: zix-hero-content
  Renders heading, description, and CTA buttons for any template.
  All values are passed in as variables (not read from block.settings directly),
  so this snippet works for both the block-settings path and the metafield-sync path.

  Expected variables (passed via render tag):
    badge_text, subheading, heading, description,
    primary_button_text, primary_button_url,
    secondary_button_text, secondary_button_url
{% endcomment %}

{% if badge_text != blank %}
  <div class="zix-hero__badge">{{ badge_text }}</div>
{% endif %}

{% if subheading != blank %}
  <p class="zix-hero__subheading">{{ subheading | escape }}</p>
{% endif %}

{% if heading != blank %}
  <h2 class="zix-hero__heading">{{ heading }}</h2>
{% endif %}

{% if description != blank %}
  <p class="zix-hero__description">{{ description }}</p>
{% endif %}

<div class="zix-hero__buttons">
  {% if primary_button_text != blank %}
    <a
      href="{{ primary_button_url | default: '#' }}"
      class="zix-btn zix-btn--primary"
      {% if primary_button_url == blank %}aria-disabled="true"{% endif %}
    >
      {{ primary_button_text | escape }}
    </a>
  {% endif %}
  {% if secondary_button_text != blank %}
    <a
      href="{{ secondary_button_url | default: '#' }}"
      class="zix-btn zix-btn--secondary"
      {% if secondary_button_url == blank %}aria-disabled="true"{% endif %}
    >
      {{ secondary_button_text | escape }}
    </a>
  {% endif %}
</div>
