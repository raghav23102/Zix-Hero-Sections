{% comment %}
  Zix Hero Sections — Standalone Section (Theme App Extension)

  This file lives in the /sections folder of the Theme App Extension.
  Merchants can add it via: Online Store → Themes → Customize → Add section → Apps → Zix Hero Sections

  It renders the full hero section using Liquid + CSS + minimal JavaScript.
  No external libraries. Lightweight. Performant. Accessible.
{% endcomment %}

{%- liquid
  assign template_id  = section.settings.template_id
  assign use_gradient = section.settings.use_gradient
-%}

<div
  class="zix-hero zix-hero--{{ template_id }}"
  id="zix-hero-section-{{ section.id }}"
  style="
    --zix-bg: {{ section.settings.background_color }};
    --zix-overlay-color: {{ section.settings.overlay_color }};
    --zix-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --zix-heading-color: {{ section.settings.heading_color }};
    --zix-text-color: {{ section.settings.text_color }};
    --zix-btn-color: {{ section.settings.button_color }};
    --zix-btn-text: {{ section.settings.button_text_color }};
    --zix-btn-radius: {{ section.settings.button_border_radius }}px;
    --zix-height: {{ section.settings.section_height }};
    --zix-pt: {{ section.settings.desktop_padding_top }}px;
    --zix-pb: {{ section.settings.desktop_padding_bottom }}px;
    --zix-heading-size: {{ section.settings.heading_size }};
    --zix-text-align: {{ section.settings.text_alignment }};
    --zix-gradient-start: {{ section.settings.gradient_start }};
    --zix-gradient-end: {{ section.settings.gradient_end }};
  "
  {{ section.shopify_attributes }}
>
  {% comment %} Background image / video {% endcomment %}
  {% if template_id == 'video-background' and section.settings.video_url != blank %}
    <div class="zix-hero__video-wrap">
      <video
        class="zix-hero__video"
        autoplay
        muted
        loop
        playsinline
        aria-hidden="true"
      >
        <source src="{{ section.settings.video_url }}" type="video/mp4">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1920 | image_tag: class: 'zix-hero__video-fallback', loading: 'lazy', alt: section.settings.image.alt }}
        {% endif %}
      </video>
    </div>
  {% elsif section.settings.image != blank
      and template_id != 'modern-split'
      and template_id != 'product-showcase'
      and template_id != 'minimal'
      and template_id != 'gradient' %}
    <div
      class="zix-hero__bg-image"
      style="background-image: url('{{ section.settings.image | image_url: width: 1920 }}');"
      role="img"
      aria-label="{{ section.settings.image.alt | escape }}"
    ></div>
  {% elsif use_gradient %}
    {%- comment -%}Gradient applied via CSS variable{%- endcomment -%}
  {% endif %}

  {% comment %} Overlay {% endcomment %}
  {% if section.settings.overlay_opacity > 0 %}
    <div class="zix-hero__overlay" aria-hidden="true"></div>
  {% endif %}

  {% comment %} Main content {% endcomment %}
  <div class="zix-hero__inner zix-hero__inner--{{ section.settings.content_width }}">

    {%- comment -%} SPLIT LAYOUT (modern-split, product-showcase, editorial) {%- endcomment -%}
    {% if template_id == 'modern-split' or template_id == 'product-showcase' or template_id == 'editorial' %}
      <div class="zix-hero__split {% if section.settings.image_position == 'left' %}zix-hero__split--reverse{% endif %}">
        <div class="zix-hero__split-content zix-animate {{ section.settings.animation_type }}" data-zix-animate>
          {%- render 'zix-hero-content', block: section -%}
          {% if template_id == 'product-showcase' and section.settings.product_price != blank %}
            <p class="zix-hero__product-price">{{ section.settings.product_price }}</p>
          {% endif %}
        </div>
        {% if section.settings.image != blank %}
          <div class="zix-hero__split-image">
            {{ section.settings.image | image_url: width: 900 | image_tag:
              loading: 'lazy',
              class: 'zix-hero__img',
              alt: section.settings.image.alt,
              widths: '400, 600, 800, 900',
              sizes: '(min-width: 768px) 50vw, 100vw'
            }}
          </div>
        {% endif %}
      </div>

    {%- comment -%} BEFORE/AFTER LAYOUT {%- endcomment -%}
    {% elsif template_id == 'before-after' %}
      <div class="zix-hero__center zix-animate {{ section.settings.animation_type }}" data-zix-animate>
        {%- render 'zix-hero-content', block: section -%}
      </div>
      <div class="zix-before-after" id="zix-ba-{{ section.id }}" aria-label="Before and after comparison">
        {% if section.settings.after_image != blank %}
          {{ section.settings.after_image | image_url: width: 900 | image_tag:
            class: 'zix-ba__after',
            loading: 'lazy',
            alt: section.settings.after_image.alt | default: 'After'
          }}
        {% else %}
          <div class="zix-ba__after zix-ba__placeholder">After</div>
        {% endif %}
        <div class="zix-ba__before-wrap" style="width: 50%;">
          {% if section.settings.before_image != blank %}
            {{ section.settings.before_image | image_url: width: 900 | image_tag:
              class: 'zix-ba__before',
              loading: 'lazy',
              alt: section.settings.before_image.alt | default: 'Before'
            }}
          {% else %}
            <div class="zix-ba__before zix-ba__placeholder">Before</div>
          {% endif %}
        </div>
        <button class="zix-ba__handle" aria-label="{{ 'sections.zix.before_after_drag' | t: default: 'Drag to compare before and after' }}">
          <span class="zix-ba__handle-icon" aria-hidden="true">↔</span>
        </button>
      </div>

    {%- comment -%} COUNTDOWN LAYOUT {%- endcomment -%}
    {% elsif template_id == 'countdown' %}
      <div class="zix-hero__center zix-animate {{ section.settings.animation_type }}" data-zix-animate>
        {%- render 'zix-hero-content', block: section -%}
        {% if section.settings.countdown_end_date != blank %}
          <div class="zix-countdown" data-zix-countdown="{{ section.settings.countdown_end_date }}" data-zix-completion="{{ section.settings.countdown_completion_message | escape }}">
            <div class="zix-countdown__unit">
              <span class="zix-countdown__value" data-zix-days>00</span>
              <span class="zix-countdown__label">{{ 'sections.zix.days' | t: default: 'Days' }}</span>
            </div>
            <div class="zix-countdown__sep">:</div>
            <div class="zix-countdown__unit">
              <span class="zix-countdown__value" data-zix-hours>00</span>
              <span class="zix-countdown__label">{{ 'sections.zix.hours' | t: default: 'Hours' }}</span>
            </div>
            <div class="zix-countdown__sep">:</div>
            <div class="zix-countdown__unit">
              <span class="zix-countdown__value" data-zix-minutes>00</span>
              <span class="zix-countdown__label">{{ 'sections.zix.minutes' | t: default: 'Minutes' }}</span>
            </div>
            <div class="zix-countdown__sep">:</div>
            <div class="zix-countdown__unit">
              <span class="zix-countdown__value" data-zix-seconds>00</span>
              <span class="zix-countdown__label">{{ 'sections.zix.seconds' | t: default: 'Seconds' }}</span>
            </div>
          </div>
        {% endif %}
      </div>

    {%- comment -%} CENTERED / DEFAULT LAYOUTS {%- endcomment -%}
    {% else %}
      <div class="
        zix-hero__center
        {% if template_id == 'fashion' or template_id == 'editorial' %}zix-hero__center--bottom{% endif %}
        zix-animate {{ section.settings.animation_type }}
      " data-zix-animate>
        {%- render 'zix-hero-content', block: section -%}
        {% if template_id == 'sale' and section.settings.discount_text != blank %}
          <p class="zix-hero__discount">{{ section.settings.discount_text }}</p>
        {% endif %}
      </div>
    {% endif %}

  </div>
</div>

{% schema %}
{
  "name": "Zix Hero Section",
  "tag": "section",
  "class": "zix-section",
  "stylesheet": "zix-hero.css",
  "javascript": "zix-hero.js",
  "settings": [
    {
      "type": "select",
      "id": "template_id",
      "label": "Hero Template",
      "default": "modern-split",
      "options": [
        { "value": "modern-split",      "label": "Modern Split" },
        { "value": "fullscreen-image",  "label": "Full Screen Image" },
        { "value": "video-background",  "label": "Video Background" },
        { "value": "product-showcase",  "label": "Product Showcase" },
        { "value": "fashion",           "label": "Fashion" },
        { "value": "minimal",           "label": "Minimal" },
        { "value": "gradient",          "label": "Gradient Modern" },
        { "value": "image-cta",         "label": "Image + CTA" },
        { "value": "collection",        "label": "Collection" },
        { "value": "sale",              "label": "Sale Promotion" },
        { "value": "countdown",         "label": "Countdown" },
        { "value": "before-after",      "label": "Before & After" },
        { "value": "animated",          "label": "Animated" },
        { "value": "editorial",         "label": "Premium Editorial" }
      ]
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "placeholder": "SALE, NEW, etc."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Beautiful Hero Section"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Add a professional hero section to your store without any coding."
    },
    {
      "type": "header",
      "content": "Primary Button"
    },
    {
      "type": "text",
      "id": "primary_button_text",
      "label": "Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "primary_button_url",
      "label": "Button URL"
    },
    {
      "type": "header",
      "content": "Secondary Button"
    },
    {
      "type": "text",
      "id": "secondary_button_text",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "secondary_button_url",
      "label": "Button URL"
    },
    {
      "type": "header",
      "content": "Images & Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "default": "right",
      "options": [
        { "value": "left",  "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "Video URL (MP4)"
    },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Before Image (Before/After template)"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "After Image (Before/After template)"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#1a1a2e"
    },
    {
      "type": "checkbox",
      "id": "use_gradient",
      "label": "Use gradient background",
      "default": false
    },
    {
      "type": "color",
      "id": "gradient_start",
      "label": "Gradient Start Color",
      "default": "#667eea"
    },
    {
      "type": "color",
      "id": "gradient_end",
      "label": "Gradient End Color",
      "default": "#764ba2"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading Size",
      "default": "3.25rem",
      "options": [
        { "value": "1.5rem",   "label": "Small" },
        { "value": "2rem",     "label": "Medium" },
        { "value": "2.625rem", "label": "Large" },
        { "value": "3.25rem",  "label": "XL" },
        { "value": "4rem",     "label": "2XL" },
        { "value": "5rem",     "label": "3XL" }
      ]
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "default": "center",
      "options": [
        { "value": "left",   "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right",  "label": "Right" }
      ]
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "Section Height",
      "default": "600px",
      "options": [
        { "value": "400px", "label": "400px" },
        { "value": "500px", "label": "500px" },
        { "value": "600px", "label": "600px" },
        { "value": "700px", "label": "700px" },
        { "value": "800px", "label": "800px" },
        { "value": "100vh", "label": "Full Screen" }
      ]
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content Width",
      "default": "wide",
      "options": [
        { "value": "narrow", "label": "Narrow" },
        { "value": "medium", "label": "Medium" },
        { "value": "wide",   "label": "Wide" },
        { "value": "full",   "label": "Full" }
      ]
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "label": "Desktop Padding Top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "label": "Desktop Padding Bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Button Border Radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "checkbox",
      "id": "enable_animation",
      "label": "Enable animation",
      "default": true
    },
    {
      "type": "select",
      "id": "animation_type",
      "label": "Animation Type",
      "default": "fade",
      "options": [
        { "value": "",          "label": "None" },
        { "value": "fade",      "label": "Fade In" },
        { "value": "slide-up",  "label": "Slide Up" },
        { "value": "slide-left","label": "Slide Left" }
      ]
    },
    {
      "type": "header",
      "content": "Sale & Countdown"
    },
    {
      "type": "text",
      "id": "discount_text",
      "label": "Discount Text",
      "placeholder": "Use code: SAVE20"
    },
    {
      "type": "text",
      "id": "countdown_end_date",
      "label": "Countdown End Date",
      "placeholder": "2025-12-31T23:59:59"
    },
    {
      "type": "text",
      "id": "countdown_completion_message",
      "label": "Countdown Completion Message",
      "default": "The offer has ended. Check back soon!"
    },
    {
      "type": "header",
      "content": "Product Showcase"
    },
    {
      "type": "text",
      "id": "product_price",
      "label": "Product Price",
      "placeholder": "$49.99"
    }
  ],
  "presets": [
    {
      "name": "Zix Hero Section",
      "settings": {
        "template_id": "modern-split",
        "heading": "Beautiful Hero Section",
        "description": "Add a professional hero section to your store without any coding.",
        "primary_button_text": "Shop Now",
        "background_color": "#1a1a2e",
        "heading_color": "#ffffff",
        "text_color": "#ffffff"
      }
    }
  ]
}
{% endschema %}
